generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Estado de la conversación de WhatsApp en curso para un teléfono.
// Vive solo mientras dura el intercambio; una vez que se genera la
// Solicitud, el contexto ya no hace falta pero se deja para poder
// retomar si el usuario escribe de nuevo más tarde.
model Conversacion {
  id            String   @id @default(cuid())
  telefono      String   @unique
  paso          String // ver src/lib/conversation.ts: nombres de los pasos
  contextoJson  Json     @default("{}")
  actualizadoEn DateTime @updatedAt
  creadoEn      DateTime @default(now())
}

// Cliente ya dado de alta (por el bot o cargado a mano por Pablo). Si un
// teléfono conocido escribe, el bot ya sabe que es cliente y de qué
// aplicativo(s) es dueño — no vuelve a preguntar nombre ni aplicativo en
// cada consulta.
model Cliente {
  id          String   @id @default(cuid())
  telefono    String   @unique
  nombre      String
  // Nombres de los aplicativos/sistemas que tiene ese cliente (ej. "Bot de
  // turnos", "Redes sociales"). Se cargan acá a mano (o se completan solos)
  // una vez que el aplicativo está en producción — al momento del alta
  // todavía no existen.
  aplicativos String[] @default([])
  notas       String?
  creadoEn    DateTime @default(now())
  actualizadoEn DateTime @updatedAt
}

enum TipoSolicitud {
  ALTA_CLIENTE
  INCIDENCIA
  TAREA_NUEVA
  MODIFICACION
  // Aprobación de una pieza de contenido (publicación) — reemplaza el paso
  // de que el cliente edite la columna Estado de la planilla a mano. Ver
  // src/lib/conversation.ts (rama de aprobación) y
  // src/app/api/admin/notificar-publicacion/route.ts.
  APROBACION_PUBLICACION
}

enum EstadoSolicitud {
  NUEVA
  EN_PROCESO
  RESUELTA
}

// Respuesta del cliente a una APROBACION_PUBLICACION. Nula hasta que
// contesta. APROBADO = luz verde, sigue el circuito normal (Imgur +
// calendario). CAMBIOS = el comentario del cliente queda en `descripcion`,
// la pieza vuelve como Denegada en la planilla para que la agencia la
// corrija y vuelva a mandar.
enum RespuestaAprobacion {
  APROBADO
  CAMBIOS
}

// Todo lo que entra por el bot termina acá: un cliente nuevo pidiendo
// alta, o un cliente existente reportando una incidencia / pidiendo una
// tarea nueva / pidiendo una modificación. La revisión diaria de la
// agencia lee esta tabla (vía /api/admin/solicitudes) en vez de leer
// Google Forms para estos dos casos.
model Solicitud {
  id           String          @id @default(cuid())
  tipo         TipoSolicitud
  estado       EstadoSolicitud @default(NUEVA)
  telefono     String
  nombre       String?
  aplicativo   String? // sobre qué app/servicio es (incidencia, tarea, modificación)
  descripcion  String? // texto libre: problema, pedido, etc.
  // Para ALTA_CLIENTE: todas las respuestas del cuestionario, una clave
  // por pregunta (ver src/lib/preguntas-alta-cliente.ts para los ids).
  respuestas   Json?
  notaInterna  String? // para que Pablo deje comentarios sin tocar el resto
  // Cuando la Solicitud pasa a RESUELTA con este campo cargado, el bot le
  // manda este texto al cliente por WhatsApp automáticamente (ver
  // PATCH /api/admin/solicitudes/[id]). No se usa para APROBACION_PUBLICACION
  // (esa confirmación la manda directo el motor de conversación).
  detalleResolucion String?
  resueltoEn   DateTime?

  // --- Campos propios de APROBACION_PUBLICACION ---
  // Nombre de archivo (columna `Archivo` de la planilla del cliente) o ID de
  // fila — lo que identifica de forma única a la pieza en cuestión.
  archivo      String?
  // Link (de Drive) que se le mandó al cliente para que revise la pieza.
  linkPreview  String?
  // Qué contestó el cliente. Nulo hasta que responde. Si es CAMBIOS, el
  // comentario del cliente se guarda en `descripcion` (mismo campo que ya
  // usan INCIDENCIA/TAREA_NUEVA/MODIFICACION para texto libre).
  respuestaAprobacion RespuestaAprobacion?
  // La revisión diaria de la agencia, después de leer una APROBACION_PUBLICACION
  // en estado RESUELTA, actualiza la fila correspondiente en la planilla
  // (Estado=Aprobado/Denegado) y marca esto en true para no reprocesarla.
  aplicadoEnPlanilla Boolean @default(false)
  // true = esta Solicitud nació del circuito de "publicación directa"
  // (agencia/decision-circuito-publicacion-directa.md): el cliente mandó una
  // foto suelta por WhatsApp fuera de cualquier flujo, sin que exista todavía
  // una fila puntual de la planilla asociada. Nace directo en RESUELTA/APROBADO
  // (ver crearFotoDirectaPublicacion en solicitudes.ts) porque no hay pregunta
  // que el cliente tenga que responder — el solo hecho de mandar la foto ya es
  // la aprobación. La revisión diaria es la que, más tarde, la empareja FIFO
  // con la fila "Esperando foto" más antigua del mismo cliente y recién ahí la
  // marca aplicadoEnPlanilla=true. Si es false (default), es una
  // APROBACION_PUBLICACION del circuito viejo: ya nació ligada a una fila
  // puntual y pasó por la pregunta "Respondé APROBAR" (ver
  // crearAprobacionPublicacion).
  fotoDirecta  Boolean @default(false)
  // Título/etiqueta corta de a qué publicación corresponde esta foto directa
  // (ej. "masajes 15/09"). Se completa de dos formas posibles: (a) el bot se
  // lo pregunta a la clienta apenas manda la foto (ver conversation.ts, paso
  // esperando_titulo_foto) y guarda lo que contesta tal cual, o (b) queda
  // null si no contestó — en ese caso la revisión diaria vuelve al
  // emparejamiento FIFO ciego de antes. Con título cargado, la revisión
  // diaria prioriza matchear por título contra las filas "Esperando foto"
  // de la planilla antes de caer al FIFO por fecha de creación.
  tituloFoto   String?

  creadoEn     DateTime        @default(now())
  actualizadoEn DateTime       @updatedAt

  @@index([estado])
  @@index([tipo])
}

// Configuración por cliente para el cron de "avisos de foto pendiente"
// (agencia/decision-cron-avisos-fotos-pendientes.md). Antes esto era Claude
// leyendo la planilla a mano en la revisión diaria de cada cliente y
// mandando el WhatsApp él mismo; se movió a un cron propio del backend
// (sin agente en el medio) para que escale a muchos clientes sin depender
// de una sesión de Claude por cada aviso. Una fila por cliente que use el
// circuito de "publicación directa" (agencia/decision-circuito-publicacion-directa.md).
model ClienteContenidoConfig {
  id               String   @id @default(cuid())
  // Identificador corto y estable del cliente (no cambia aunque cambie de
  // nombre comercial) — ej. "romina-balquinta". Se usa como clave en
  // AvisoFotoPendiente y en Publicacion.clienteSlug.
  slug             String   @unique
  nombre           String
  // ID del Google Sheet (el que aparece en la URL) — SOLO para clientes que
  // todavía no migraron a la tabla Publicacion (ver decisión de
  // agencia/decision-cron-avisos-fotos-pendientes.md, sección "de Sheets a
  // base propia"). Null = este cliente ya vive 100% en Publicacion, no hace
  // falta pedirle ni compartir ninguna planilla de Google. Tiene que estar
  // compartido "Cualquiera con el enlace - Lector" para que el cron lo pueda
  // leer sin credenciales de Google, mientras siga en uso.
  planillaSheetId  String?
  // gid de la pestaña de publicaciones (no la de feedback) — "0" en RB
  // Estética hoy. Sin efecto si planillaSheetId es null.
  planillaGid      String   @default("0")
  // A cuántos días de la fecha de publicación se le manda el aviso de "falta
  // esta foto" (paso 0.ter.a de cursor-rules/revision-diaria.mdc — ahí eran
  // ~5 días fijos para todos; ahora es configurable por cliente).
  ventanaAvisoDias Int      @default(5)
  // Número de WhatsApp al que se le manda el aviso (el personal de la
  // clienta, no el de trabajo — ver la nota de loop bot-contra-bot en
  // agencia/decision-filtro-antiloop-bots-clientes.md).
  telefonoAviso    String
  activo           Boolean  @default(true)
  creadoEn         DateTime @default(now())
  actualizadoEn    DateTime @updatedAt
}

// Registro de que ya se le avisó a un cliente que le falta la foto de una
// fila puntual de la planilla — evita que el cron le mande el mismo aviso
// todos los días mientras la fila sigue en Esperando foto. Se identifica la
// fila por clienteSlug+fecha+hora (no hay un ID de fila estable en Google
// Sheets vía CSV público), que alcanza porque una fecha/hora no se repite
// dos veces en el calendario de un mismo cliente.
model AvisoFotoPendiente {
  id          String   @id @default(cuid())
  clienteSlug String
  fecha       String // tal cual viene la columna Fecha de la planilla, ej. "15/9/2026"
  hora        String
  archivo     String?
  tituloUsado String // el título que se le pidió usar al cliente al responder al bot
  enviadoEn   DateTime @default(now())

  @@unique([clienteSlug, fecha, hora])
}

enum EstadoPublicacion {
  ESPERANDO_FOTO
  PENDIENTE
  APROBADO
  DENEGADO
}

// Reemplazo de la fila de Google Sheets — vive en la misma base que el
// resto de la app, así un cliente nuevo no necesita que se le comparta ni
// se le explique una planilla (ver agencia/decision-cron-avisos-fotos-pendientes.md,
// sección "de Sheets a base propia"). Un cliente puede tener muchas filas;
// se identifica por clienteSlug (no hay FK formal a ClienteContenidoConfig
// para no obligar a que exista una config de cron para poder cargar
// contenido — algunos clientes pueden no usar el circuito de foto directa).
model Publicacion {
  id          String            @id @default(cuid())
  clienteSlug String
  fecha       DateTime // solo la parte de fecha importa — hora va aparte en `hora`
  hora        String // "HH:MM", hora de salida en Instagram/Facebook
  texto       String
  linkImagen  String?
  red         String? // vacío = todas las redes configuradas del cliente
  estado      EstadoPublicacion @default(PENDIENTE)
  publicado   Boolean           @default(false)
  archivo     String?
  observacion String?
  linkDrive   String?
  tema        String? // título corto para el matching de foto directa — ver buildTituloFoto
  creadoEn    DateTime          @default(now())
  actualizadoEn DateTime        @updatedAt

  @@index([clienteSlug])
  @@index([estado])
  @@index([fecha])
  @@unique([clienteSlug, fecha, hora])
}
