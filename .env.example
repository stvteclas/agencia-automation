# Base de datos Neon (Postgres). Proyecto Neon NUEVO y propio de este bot,
# no reusar el de ningún cliente (mismo criterio que turnos-app).
DATABASE_URL="postgresql://usuario:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://usuario:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Clave para llamar a /api/admin/* (header "x-admin-key"). La usa la
# revisión diaria (Cursor/Claude) para leer y actualizar Solicitudes.
# Generar con: openssl rand -hex 32
ADMIN_API_KEY="reemplazar-por-un-valor-aleatorio-largo"

# --- WhatsApp Business Platform (Cloud API) ---
# Meta Business Manager -> app de WhatsApp de la AGENCIA (no la de un cliente)
# -> WhatsApp -> Configuración de la API. Ver README para el paso a paso.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Inventado por nosotros, se lo pegamos a Meta al dar de alta el webhook.
WHATSAPP_VERIFY_TOKEN=""

# --- Aviso por mail cuando entra algo nuevo (Resend, mismo proveedor que turnos-app) ---
# Cuenta gratuita en https://resend.com -> API Keys -> Create API Key.
RESEND_API_KEY=""
# Dirección "de" con la que se manda el mail (con dominio propio verificado en
# Resend; sin dominio verificado, Resend solo deja mandar en modo prueba).
EMAIL_FROM="Bot Agencia <bot@tu-dominio.com>"
# A quién le llega el aviso de "tenés algo nuevo para revisar".
OWNER_EMAIL="pablo.murgia23@gmail.com"

# Se genera solo al conectar Vercel Blob Storage al proyecto (Vercel dashboard
# -> Storage). Ahí se guardan los logos que los prospectos manden por WhatsApp
# durante el alta de cliente.
BLOB_READ_WRITE_TOKEN=""
